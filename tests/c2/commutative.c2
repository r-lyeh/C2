// operators: 2 * v and 1 + v use v * 2 and v + 1 (a number with a struct, for + * ==), unless [[noncommutative]]
struct vec2 { float x, y; };
struct mat2 { float a, b, c, d; };
[[operator*]] vec2 vec2_scale(vec2 v, float k) { return vec2(v.x * k, v.y * k); }
[[operator+]] vec2 vec2_offset(vec2 v, float k) { return vec2(v.x + k, v.y + k); }
[[operator==]] bool vec2_is(vec2 v, float k) { return v.x == k && v.y == k; }
[[operator*, noncommutative]] mat2 mat2_scale(mat2 m, float k) { return mat2(m.a * k, m.b * k, m.c * k, m.d * k); }
int main() {
    vec2 v = 2 * vec2(1, 2) + 1;
    vec2 w = 0.5f + v;
    printf("%g %g %g %g %d %d\n", v.x, v.y, w.x, w.y, 3 == vec2(3, 3), 3 != vec2(3, 3));
    mat2 m = mat2(1, 2, 3, 4) * 2;
    printf("%g\n", m.d);
}
