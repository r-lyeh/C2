// .c2 constructors: T(...) builds a T (fields in order or by name); a function T T(...) is T's own
struct vec3 { float x, y, z; };
struct rect { vec3 lo, hi; int tag : 4; };
union num { int i; float f; };
struct P { float x, y; };
P P(float x = 1, float y = 2) { return (P){x * 10, y * 10}; }   // a constructor
float len2(vec3 v) { return v.x * v.x + v.y * v.y + v.z * v.z; }
void show(vec3 v) { printf("(%g %g %g) ", v.x, v.y, v.z); }
int main() {
    vec3(1, 2, 3).show();
    vec3(z: 9, x: 1).show();
    show(vec3(.y = 5));
    puts("");
    rect r = rect(vec3(1, 1, 1), hi: vec3(2, 2, 2), tag: 5);
    printf("%g %g %d %g\n", r.lo.x, r.hi.z, r.tag, (vec3(3, 4, 0)).len2());
    num n = num(f: 1.5f);
    printf("%g\n", n.f);
    P a = P(), b = P(3), c = P(y: 7);
    printf("%g %g | %g %g | %g %g\n", a.x, a.y, b.x, b.y, c.x, c.y);
    vec3 arr[2] = { vec3(1, 0, 0), vec3(0, 1, 0) };
    for (vec3 v = vec3(0, 0, 0); v.x < 2; v.x++) printf("%g ", v.x);
    int k = ({ vec3 t = vec3(2, 2, 1); (int)t.len2(); });
    vec3 (*fp)(void) = 0;   // still a declaration
    printf("| %g %d %d\n", arr[1].y, k, fp == 0);
    return 0;
}
