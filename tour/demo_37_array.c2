// array(T) is a plain T * with its count stored before the elements: a[i] and C calls just work.
// Its functions are methods too: a.push(x) is array_push(a, x).
#import "runtime"
int main() {
    array(int) a;
    for (int i = 1; i <= 5; i++) a.push(i * i);
    printf("%zu items, last %d\n", a.count(), a[4]);
    a.free();
}
